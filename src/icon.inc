; ---------------------------------------------------------------------------
; icon.inc -- drawing icons, and the tick counter double-click needs
;
; An icon is 14 pixels wide, which is two screen bytes exactly, so one placed
; on an even byte column occupies one auxiliary byte and one main byte per row
; and needs no shifting.  That is the whole reason for the width: a shifted
; blit would need the same span logic HgrHLine has, for no visible gain at
; this size.
;
; Icons are drawn opaque -- the two bytes replace what was there.  With a
; grey dithered desktop a masked blit would look better, but it needs a second
; bitmap per icon, and this system repaints rather than composites.
; ---------------------------------------------------------------------------

.include "icons.inc"            ; generated by tools/mkicons.py

; Draw icon number IICON at byte column ICOL, top raster row IROW.
HgrIcon:
        lda     IICON                   ; offset = icon * ICONBYTES
        sta     ITMP
        lda     #0
        sta     IPTR+1
        lda     ITMP
        ldy     #5                      ; ICONBYTES is 32
@shift: asl     a
        rol     IPTR+1
        dey
        bne     @shift
        clc
        adc     #<ICONBASE
        sta     IPTR
        lda     IPTR+1
        adc     #>ICONBASE
        sta     IPTR+1

        lda     #0
        sta     IIDX                    ; row within the icon
@row:   lda     IROW
        clc
        adc     IIDX
        cmp     #192
        bcs     @next                   ; off the bottom
        sta     HY
        jsr     HgrRow

        lda     IIDX                    ; two bytes per row
        asl     a
        tay
        lda     (IPTR),y
        sta     ITMP                    ; left half
        iny
        lda     (IPTR),y
        sta     ITMP2                   ; right half

        lda     ICOL                    ; left byte: aux when ICOL is even
        cmp     #80
        bcs     @next
        jsr     SelectBank
        ldy     HBYTE
        lda     ITMP
        sta     (HBASE),y

        lda     ICOL                    ; right byte is the other bank
        clc
        adc     #1
        cmp     #80
        bcs     @next
        jsr     SelectBank
        ldy     HBYTE
        lda     ITMP2
        sta     (HBASE),y

@next:  inc     IIDX
        lda     IIDX
        cmp     #16
        bne     @row
        bit     MAINSEL
        rts

; ---------------------------------------------------------------------------
; Forth words
; ---------------------------------------------------------------------------
        prim    "ICON", W_ICON, 0       ; col row n --
        lda     0,x
        sta     IICON
        lda     2,x
        sta     IROW
        lda     4,x
        sta     ICOL
        txa
        clc
        adc     #6
        tax
        jsr     HgrIcon
        NEXT

; TICKS -- a free-running counter the event loop bumps once per pass.  There
; is no clock in this machine, and double-click only needs to know "soon
; after", not how many milliseconds.
        prim    "TICK", W_TICKBUMP, 0       ; --
        inc     TICKS
        bne     :+
        inc     TICKS+1
:       NEXT

        prim    "TICKS", W_TICKSW, 0    ; -- n
        dex
        dex
        lda     TICKS
        sta     0,x
        lda     TICKS+1
        sta     1,x
        NEXT

; ---------------------------------------------------------------------------
        .segment "DATA"
IICON:  .byte   0
ICOL:   .byte   0
IROW:   .byte   0
IIDX:   .byte   0
ITMP:   .byte   0
ITMP2:  .byte   0
TICKS:  .word   0
        .segment "CODE"
