; ---------------------------------------------------------------------------
; text.inc -- text on the double hi-res screen: 80 columns by 24 rows
;
; A screen byte holds 7 pixels and the font is 7 wide, so a character occupies
; exactly one byte column.  Drawing one is eight stores down consecutive
; raster rows -- no shifting, no read-modify-write, no clipping arithmetic.
; That alignment is the whole reason the font is 7 wide rather than 5, and it
; is what makes double hi-res give a full 80 columns.
;
; The only thing the extra resolution costs is picking a bank: even columns
; live in auxiliary memory, odd ones in main.  The column is fixed for a whole
; character, so that happens once per glyph rather than once per row.
; ---------------------------------------------------------------------------

.include "font.inc"             ; generated by tools/mkfont.py

; Draw the ASCII character in A at column TCOL, row TROW.
HgrPutChar:
        cmp     #'a'            ; the font covers $20-$5F only, so fold lower
        bcc     @nofold         ; case rather than print it as a blank
        cmp     #'z'+1
        bcs     @nofold
        sec
        sbc     #$20
@nofold:
        sec
        sbc     #$20
        cmp     #64
        bcc     :+
        lda     #0              ; anything outside the font prints as a space
:       sta     TIDX
        lda     #0              ; font offset = glyph * 8
        sta     TPTR+1
        lda     TIDX
        asl     a
        rol     TPTR+1
        asl     a
        rol     TPTR+1
        asl     a
        rol     TPTR+1
        clc
        adc     #<FONT
        sta     TPTR
        lda     TPTR+1
        adc     #>FONT
        sta     TPTR+1

        lda     TCOL            ; the bank is fixed for the whole glyph
        cmp     #80
        bcs     @offscreen
        jsr     SelectBank      ; leaves the row index in HBYTE

        lda     TROW            ; first raster row = TROW * 8
        asl     a
        asl     a
        asl     a
        sta     TY
        lda     #0
        sta     TIDX
@row:   clc
        lda     TY
        adc     TIDX
        cmp     #192
        bcs     @next           ; off the bottom
        sta     HY
        jsr     HgrRow
        ldy     TIDX
        lda     (TPTR),y
        eor     TINVF           ; $7F swaps ink and paper
        ldy     HBYTE
        sta     (HBASE),y
@next:  inc     TIDX
        lda     TIDX
        cmp     #8
        bne     @row
@offscreen:
        bit     MAINSEL         ; never leave aux selected: 80STORE makes the
        rts                     ; same switch cover the text page

; ---------------------------------------------------------------------------
; Forth words
; ---------------------------------------------------------------------------
        prim    "TAT", W_TAT, 0         ; col row --
        lda     0,x
        sta     TROW
        lda     2,x
        sta     TCOL
        inx
        inx
        inx
        inx
        NEXT

        prim    "TEMIT", W_TEMIT, 0     ; c --
        lda     0,x
        inx
        inx
        jsr     HgrPutChar
        inc     TCOL
        NEXT

        prim    "TINV", W_TINV, 0       ; flag --  (non-zero = inverse video)
        lda     0,x
        ora     1,x
        inx
        inx
        cmp     #$00                    ; INX clobbered Z; A still holds the OR
        beq     @off
        lda     #$7F
        sta     TINVF
        NEXT
@off:   lda     #$00
        sta     TINVF
        NEXT

; Print the inline counted string that follows, on the hi-res screen.
        headlink
        .byte   5
        .byte   '(', 'T', '.', '"', ')'
W_PTDOTQ:
        ldy     #0
        lda     (IP),y
        sta     TMP1
        beq     @skip
        sta     TMP2
        ldy     #1
@l:     lda     (IP),y
        sty     YSAV                    ; HgrPutChar uses Y
        jsr     HgrPutChar
        inc     TCOL
        ldy     YSAV
        iny
        dec     TMP2
        bne     @l
@skip:  sec                             ; IP += length + 1
        lda     TMP1
        adc     IP
        sta     IP
        bcc     :+
        inc     IP+1
:       NEXT

; T." <text>"  -- the hi-res counterpart of ."
        headlink
        .byte   3 | F_IMMED
        .byte   'T', '.', '"'
W_TDOTQUOTE:
        lda     #<W_PTDOTQ
        ldy     #>W_PTDOTQ
        jsr     CommaWord
        lda     DPV
        sta     STRLEN
        lda     DPV+1
        sta     STRLEN+1
        lda     #0
        jsr     CComma                  ; placeholder count byte
        lda     #0
        sta     NCNT
        ldy     TOIN                    ; skip exactly one delimiting blank
        cpy     TIBLEN
        bcs     @done
        lda     TIB,y
        cmp     #' '
        bne     @copy
        iny
@copy:  cpy     TIBLEN
        bcs     @done
        lda     TIB,y
        iny
        cmp     #'"'
        beq     @done
        sty     YSAV
        jsr     CComma
        ldy     YSAV
        inc     NCNT
        bne     @copy
@done:  sty     TOIN
        lda     STRLEN
        sta     UTMP
        lda     STRLEN+1
        sta     UTMP+1
        lda     NCNT
        ldy     #0
        sta     (UTMP),y
        NEXT
